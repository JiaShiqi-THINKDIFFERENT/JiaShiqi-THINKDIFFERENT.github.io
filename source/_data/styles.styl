// ==============================================================
// 卡片信息密度（P0-3 · post-meta-extra.js 注入标签/时长/封面）
// 目标：列表页卡片从"标题 + 200 字大段摘要"变成紧凑信息流——
// 标题 → 两行摘要(+右侧缩略图) → 元信息行(日期/分类/标签/时长/字数)。
// 作用域限定在列表页容器，文章页正文不受影响。
// ==============================================================
.main-inner.index,
.main-inner.archive,
.main-inner.category,
.main-inner.tag {
  // 列表整体收进一个白色圆角容器（NexT Gemini 默认给每篇独立白卡+阴影，
  // 此处去卡片化：条目透明、只用横线分隔）
  background: var(--content-bg-color);
  border-radius: 6px;
  box-shadow: 0 2px 2px 0 rgba(0, 0, 0, 0.08), 0 1px 5px 0 rgba(0, 0, 0, 0.06);
  padding: 4px 20px 10px;

  // :not(#_) 纯粹为了把特异性提到 (1,3,0)，稳定压过主题的
  // `.main-inner .post-block:not(:first-child):not(:first-child)` (0,4,0)
  // ——否则白底/阴影/margin 会在不同规则里此消彼长。
  .post-block:not(#_) {
    background: transparent;
    border-bottom: 1px solid var(--table-row-hover-bg-color);
    border-radius: 0;
    box-shadow: none;
    margin: 0;
    padding: 13px 0;
  }

  .post-block:not(#_):last-of-type {
    border-bottom: none;
  }

  .post-header {
    margin-bottom: 4px;
  }

  .post-title {
    font-size: 1.1em; // 列表页字号收小，信息密度更高
    line-height: 1.45;
  }

  .post-meta {
    font-size: 11.5px;
    margin-top: 2px;
  }

  // 摘要区：只留纯文字段落，引用块/标题/列表/代码块/图片在列表里只会撑高且无信息量
  .post-body {
    margin-top: 4px;

    blockquote,
    h1, h2, h3, h4, h5, h6,
    pre,
    table,
    ul, ol,
    img,
    .highlight {
      display: none;
    }

    p {
      display: -webkit-box;
      -webkit-line-clamp: 2; // 摘要最多两行
      -webkit-box-orient: vertical;
      color: var(--blockquote-color);
      font-size: 14.5px;
      line-height: 1.75;
      overflow: hidden;
      margin-bottom: 0;
    }

    // 多段摘要只保留第一段，条目高度整齐（完整摘要进文章页看）
    p:not(:first-of-type) {
      display: none;
    }
  }

  // 列表页不显示"阅读全文"按钮——整个标题与摘要区域即可点击进全文
  .post-button {
    display: none;
  }
}

// 元信息行补充项：阅读时长 / 字数（由脚本追加）
.clivia-meta-extra {
  color: var(--blockquote-color);
}

// 列表页标签 chip
.clivia-card-tags {
  clear: both;
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  margin: 6px 0 0;
}

.clivia-tag-chip {
  background: var(--table-row-hover-bg-color);
  border: 0;
  border-radius: 9px;
  color: var(--blockquote-color);
  font-size: 11px;
  line-height: 1.6;
  padding: 0 8px;
  transition: background 0.2s ease, color 0.2s ease;
}

.clivia-tag-chip:hover {
  background: var(--brand-color);
  color: #ffffff;
}

@media (prefers-color-scheme: dark) {
  .clivia-tag-chip:hover {
    background: var(--brand-color);
  }
}

@media (min-width: 992px) {
  body {
    padding-top: 48px; // 给 fixed 导航条让位
  }

  .clivia-navbar {
    display: block;
  }

  // 品牌大标题已上移到顶部导航条，左栏内不再重复显示
  // （仅移动端保留，因为那里导航条是隐藏的）
  .site-brand-container {
    display: none;
  }

  // 顶部留白收紧：导航条(48px) 与首个菜单项之间只保留 12px。
  // 原来这里叠了三层间距——headband 3px + .site-nav 18px + .menu 1em(16px) = 37px，
  // 菜单整体被推得很低。headband 是 NexT 顶部装饰条，加了吸顶导航条后它是多余的
  // （被 body 的 padding-top 顶到导航条正下方，只剩一条 3px 细线）。
  .headband {
    display: none;
  }

  .site-nav {
    padding-top: 4px;
  }

  // 主题默认 .menu{padding:1em 0}（上下各 16px），上下一并收窄
  .menu {
    padding-top: 8px;
    padding-bottom: 8px;
  }
}

// ---------------------------------------------------------------------------
// 个股页「研究」章节：三好分析 + 四维度分析 两卡并列
// ---------------------------------------------------------------------------
// 「研究」章节：各分析方法卡片从上到下依次排列（三好 → 四维度 → 后续新方法）
// 新增方法只需往 .research-pair 里加一个 <div id="xxx" data-slug="...">，间距自动生效
.research-pair {
  display: grid;
  grid-template-columns: 1fr;
  gap: 16px;
  align-items: start;
  margin: 1em 0 1.4em;
}

.research-pair > div {
  margin: 0;
}

// 卡片内层自带外边距会与 grid gap 叠加，统一清零（新增方法的卡片类名需在此登记一行）
.research-pair .tgood,
.research-pair .fdim {
  margin: 0;
}

// ---------------------------------------------------------------------------
// 评分总览表（三好 /three-good/ 与 四维度 /four-dim/ 共用 .score-table）
// ---------------------------------------------------------------------------
.st-block {
  margin: 0 0 18px;
}

.st-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 8px;

  h2 {
    margin: 0;
    font-size: 1.15em;
  }

  .st-updated {
    font-size: 12px;
    opacity: 0.6;
  }
}

.st-scroll {
  overflow-x: auto;
}

table.st-table {
  width: 100%;
  border-collapse: collapse;
  font-size: 14px;

  th,
  td {
    border: 1px solid #e6e6e6;
    padding: 8px 10px;
    text-align: left;
    vertical-align: middle;
  }

  thead th {
    background: #fafafa;
    font-weight: 600;
    white-space: nowrap;
  }

  tbody tr:hover {
    background: #fcfdfc;
  }
}

.st-name a {
  text-decoration: none;
  font-weight: 600;
}

.st-code {
  font-weight: 400;
  font-size: 12px;
  opacity: 0.65;
}

.st-ind {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 10px;
  background: #f1f5f2;
  color: #42584c;
  font-size: 12px;
  white-space: nowrap;
}

.st-series {
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  align-items: baseline;
}

.st-val {
  font-size: 13px;
  color: #666;
  white-space: nowrap;
}

.st-now {
  font-weight: 700;
  font-size: 14px;
  color: #222;
}

// 不足 5 篇时的占位格（保持与有值格子等宽，最新一期始终最右）
.st-void {
  color: #c4c4c4;
  min-width: 34px;
  display: inline-block;
}

.st-up {
  color: #c62828;
}

.st-down {
  color: #1e8e3e;
}

.st-arrow {
  font-style: normal;
  font-size: 9px;
  margin-left: 2px;
}

.st-spark-wrap {
  margin-top: 4px;
}

.st-spark {
  display: block;
}

.st-verdict {
  display: inline-block;
  padding: 2px 8px;
  border-radius: 4px;
  font-size: 12.5px;
  white-space: nowrap;
}

.v-good {
  background: #e9f6ec;
  color: #0a7d3f;
}

.v-hold {
  background: #fff6e2;
  color: #8a6100;
}

.v-watch {
  background: #ffeede;
  color: #9a4a00;
}

.v-bad {
  background: #fdeceb;
  color: #b3261e;
}

.v-none {
  background: #f2f2f2;
  color: #666;
}

.st-archive {
  margin: 6px 0 14px;

  summary {
    cursor: pointer;
    font-size: 13.5px;
    padding: 6px 0;
    color: #4a6b58;
  }

  &[open] summary {
    margin-bottom: 8px;
  }
}

.st-note {
  font-size: 12.5px;
  opacity: 0.7;
  margin: 6px 0 0;
}

.st-empty {
  opacity: 0.5;
}
