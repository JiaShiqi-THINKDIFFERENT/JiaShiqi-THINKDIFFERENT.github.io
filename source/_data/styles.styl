// ==============================================================
// CLIVIA 全局配色 —— 深墨绿
// 此文件在 main.styl 末尾注入，:root 变量覆盖优先级最高
// 主色: #1b4d3e (深墨绿) / 悬停: #0e3328
// ==============================================================

// 亮色模式
:root {
  --body-bg-color: #f4f7f5;            // 页面底色（淡墨绿灰）
  --content-bg-color: #ffffff;         // 内容卡片
  --card-bg-color: #edf3ef;            // 侧边栏 / 卡片
  --menu-item-bg-color: #edf3ef;       // 菜单项悬停底色
  --text-color: #2e3b34;               // 正文文字（墨绿灰）
  --link-color: #1b4d3e;               // 链接主色
  --link-hover-color: #0e3328;         // 链接悬停
  --link-decoration-color: #9dbcae;    // 链接下划线
  --brand-color: #1b4d3e;              // 品牌/标题强调色
  --brand-hover-color: #0e3328;
  --blockquote-color: #51635a;         // 引用文字
  --selection-bg: #cfe2d7;             // 选中文字底色
  --selection-color: #14352b;
  --table-row-odd-bg-color: #f6faf7;   // 表格奇数行
  --table-row-hover-bg-color: #e4efe8; // 表格悬停行
  --theme-color: #1b4d3e;              // 浏览器头部面板色
  --btn-default-hover-bg: #e4efe8;     // 按钮悬停
  --btn-default-hover-color: #0e3328;
  --btn-default-hover-border-color: #1b4d3e;
}

// 暗色模式（跟随系统）
@media (prefers-color-scheme: dark) {
  :root {
    --body-bg-color: #12201a;
    --content-bg-color: #17281f;
    --card-bg-color: #1c2f26;
    --menu-item-bg-color: #1c2f26;
    --text-color: #c9d6ce;
    --link-color: #7fbf9e;
    --link-hover-color: #a9dcc0;
    --link-decoration-color: #3f5c4d;
    --brand-color: #7fbf9e;
    --brand-hover-color: #a9dcc0;
    --blockquote-color: #93a89b;
    --selection-bg: #2a4437;
    --selection-color: #e6f2ea;
    --table-row-odd-bg-color: #1a2c23;
    --table-row-hover-bg-color: #23382d;
    --theme-color: #14352b;
  }
}

// ==============================================================
// 站点品牌横幅（首页顶部大标题 CLIVIA）
// 深墨绿底 + 白色加粗大标题，亮/暗模式均适用
// ==============================================================
header.header {
  background: #1b4d3e;
}

.brand {
  color: #ffffff;
}

.brand:hover {
  color: #ffffff;
}

.site-title {
  font-size: 2.25em;
  font-weight: 700;
  letter-spacing: 0.08em;
  color: #ffffff;
}

.site-subtitle {
  color: #cfe2d7;
}

// 横幅内导航菜单：深绿底上必须用白字（默认继承 --link-color 与背景同色，不可读）
.menu {
  .menu-item a {
    color: #ffffff;
  }

  .menu-item a:hover {
    color: #cfe2d7; // 悬停淡墨绿，保持可读
  }

  // 当前页对应菜单项：NexT 用 .menu-item-active 标记
  .menu-item-active a,
  li.active a {
    color: #ffffff;
    border-bottom-color: #cfe2d7; // NexT 给激活项加下划线，同步调亮
  }

  // NexT 的 hover/active 类加在 a 元素上且会加浅色背景，此时需深色字保证对比
  .menu-item a:hover,
  .menu-item a.menu-item-active {
    color: #1b4d3e;
    background: var(--menu-item-bg-color);
  }

  // 搜索/图标按钮同样提亮
  .search-popout,
  .popup {
    color: #2e3b34; // 弹层在白底上，恢复深色字
  }
}

// ==============================================================
// 全宽版面：内容区铺满视口，消除两侧大留白
// 主题默认在 ≥1200px 固定 1160px、≥1600px 固定 73%，
// 大屏上两侧留白严重；此处统一放开为全宽（仅保留 10px 安全边距）
// ==============================================================
@media (min-width: 1200px) {
  .main,
  .footer-inner {
    width: calc(100% - 20px);
    max-width: none;
  }
}

// ==============================================================
// 左栏独立滚动：菜单栏固定在视口内，与正文分别滚动
// 左栏（品牌 + 菜单 + 作者卡）高度锁定 100vh，内容超高时
// 自身出现滚动条；正文仍走页面滚动，互不影响。
// ==============================================================
@media (min-width: 992px) {
  .main > .column {
    position: sticky;
    top: 48px; // 让位给吸顶导航条（收窄态高度 48px）
    align-self: flex-start; // 抵消 .main 的 align-items: stretch 拉伸
    height: calc(100vh - 48px);
    overflow-y: auto;
    overflow-x: hidden;
    // 注意：不要加 overscroll-behavior: contain
    // 左栏内容通常不足一屏（无溢出）时，contain 会阻断滚轮向页面传递，
    // 导致鼠标停在菜单上滚不动正文。
    scrollbar-width: thin; // Firefox 细滚动条
  }

  // WebKit 细滚动条：浅色，不抢视觉
  .main > .column::-webkit-scrollbar {
    width: 5px;
  }

  .main > .column::-webkit-scrollbar-thumb {
    background: rgba(27, 77, 62, 0.28);
    border-radius: 3px;
  }

  .main > .column::-webkit-scrollbar-thumb:hover {
    background: rgba(27, 77, 62, 0.5);
  }

  .main > .column::-webkit-scrollbar-track {
    background: transparent;
  }
}

// 折叠态下左栏整体隐藏，滚动条随元素一起消失，无需额外处理

// 暗色模式：横幅内菜单文字仍为白色（背景更深，对比足够）
@media (prefers-color-scheme: dark) {
  .menu .menu-item a,
  .menu .menu-item-active a,
  .menu li.active a {
    color: #ffffff;
  }

  .menu .menu-item a:hover {
    color: #a9dcc0;
  }

  // 暗色模式浅字配深底即可，hover/active 同样用亮绿字
  .menu .menu-item a:hover,
  .menu .menu-item a.menu-item-active {
    color: #a9dcc0;
  }
}

// ==============================================================
// 左侧栏折叠（参考 CSDN 布局）
// 桌面端可隐藏整个左侧栏，内容区扩展为全宽；折叠后在视口左缘显示浮出把手。
// 关键数值：左栏 240px + 12px 间距 = 252px（与主题 .main-inner 的 calc 一致）
// ==============================================================
html.sidebar-collapsed .clivia-sidebar-toggle svg,
html.sidebar-collapsed .clivia-sidebar-reopen svg {
  transform: rotate(180deg);
}

@media (min-width: 992px) {
  header.header {
    position: relative; // 折叠按钮的定位参照
  }

  .main > .column {
    transition: margin-left 0.3s ease, opacity 0.25s ease;
  }

  .main-inner,
  .footer-inner {
    transition: width 0.3s ease, padding-left 0.3s ease;
  }

  // 折叠态：负外边距抵消左栏占位，内容区补满宽度
  html.sidebar-collapsed .main > .column {
    margin-left: -252px;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  html.sidebar-collapsed .main-inner {
    width: 100%;
  }

  html.sidebar-collapsed .footer-inner {
    padding-left: 0;
  }
}

// 折叠按钮：位于品牌区右上角（深墨绿底上白字）
.clivia-sidebar-toggle {
  align-items: center;
  background: rgba(255, 255, 255, 0.14);
  border: 0;
  border-radius: 6px;
  color: #ffffff;
  cursor: pointer;
  display: none; // 仅桌面端显示
  height: 26px;
  justify-content: center;
  padding: 0;
  position: absolute;
  right: 10px;
  top: 10px;
  transition: background 0.2s ease, color 0.2s ease;
  width: 26px;
  z-index: 5;
}

.clivia-sidebar-toggle:hover {
  background: rgba(255, 255, 255, 0.3);
}

.clivia-sidebar-toggle svg,
.clivia-sidebar-reopen svg {
  transition: transform 0.3s ease;
}

// 浮出把手：折叠后贴在视口左缘垂直居中
.clivia-sidebar-reopen {
  align-items: center;
  background: #1b4d3e;
  border: 0;
  border-radius: 0 8px 8px 0;
  box-shadow: 2px 0 6px rgba(0, 0, 0, 0.18);
  color: #ffffff;
  cursor: pointer;
  display: none;
  height: 62px;
  justify-content: center;
  left: 0;
  padding: 0;
  position: fixed;
  top: 50%;
  transform: translateY(-50%);
  transition: background 0.2s ease, width 0.2s ease;
  width: 20px;
  z-index: 30;
}

.clivia-sidebar-reopen:hover {
  background: #0e3328;
  width: 24px;
}

@media (min-width: 992px) {
  .clivia-sidebar-toggle {
    display: flex;
  }

  html.sidebar-collapsed .clivia-sidebar-reopen {
    display: flex;
  }
}

// 移动端不启用：沿用 NexT 自带抽屉侧栏
@media (max-width: 991px) {
  .clivia-sidebar-toggle,
  .clivia-sidebar-reopen {
    display: none !important;
  }
}

// 无障碍：尊重「减少动态效果」偏好
@media (prefers-reduced-motion: reduce) {
  .main > .column,
  .main-inner,
  .footer-inner,
  .clivia-sidebar-toggle svg,
  .clivia-sidebar-reopen,
  .clivia-sidebar-reopen svg {
    transition: none;
  }
}

// 暗色模式：横幅更深，按钮底色略提亮
@media (prefers-color-scheme: dark) {
  .clivia-sidebar-toggle {
    background: rgba(255, 255, 255, 0.16);
  }

  .clivia-sidebar-reopen {
    background: #1b4d3e;
  }
}

// 暗色模式：横幅用更深的墨绿，避免过亮
@media (prefers-color-scheme: dark) {
  header.header {
    background: #14352b;
  }
}

// 窄屏：汉堡菜单按钮线条改为白色，在墨绿横幅上清晰可见
@media (max-width: 991px) {
  .site-nav-toggle .toggle-line {
    background: #ffffff;
  }
}

// ==============================================================
// 顶部导航条（P0-1 · 对标 CSDN 常驻导航）
// 重要：Gemini 布局下 header（品牌+菜单）位于左栏列内而非全宽横幅，
// 因此导航条用 fixed 置顶全宽；body 顶部留出 48px，左栏 sticky 同步让位。
// 桌面端(>=992px)显示导航条并隐藏 NexT 原生菜单；移动端保留汉堡菜单。
// 收窄逻辑不再需要：左栏本身 sticky，品牌大标题始终可见；
// 仅当左栏被折叠时，导航条左侧显示 CLIVIA 字标补位。
// ==============================================================
.clivia-navbar {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  height: 48px;
  background: #1b4d3e;
  box-shadow: 0 1px 4px rgba(0, 0, 0, 0.18);
}

.clivia-navbar-inner {
  display: flex;
  align-items: center;
  gap: 26px;
  height: 100%;
  padding: 0 20px;
}

.clivia-navbar-brand {
  display: none;
  font-size: 1.15em;
  font-weight: 700;
  letter-spacing: 0.06em;
  color: #ffffff;
}

.clivia-navbar-brand:hover {
  color: #ffffff;
}

.clivia-navbar-menu {
  display: flex;
  align-items: center;
  gap: 22px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.clivia-navbar-menu > li {
  position: relative;
}

.clivia-navbar-menu > li > a {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 4px 0;
  font-size: 15px;
  color: #ffffff;
  border-bottom: 2px solid transparent;
}

.clivia-navbar-menu > li > a:hover {
  color: #cfe2d7;
}

.clivia-navbar-menu > li.is-active > a {
  color: #ffffff;
  border-bottom-color: #cfe2d7;
}

.clivia-dropdown-menu {
  display: none;
  position: absolute;
  top: 100%;
  left: -10px;
  z-index: 1001;
  margin: 0;
  padding: 10px 14px;
  list-style: none;
  min-width: 230px;
  columns: 2;
  column-gap: 16px;
  background: var(--content-bg-color);
  border: 1px solid var(--table-row-hover-bg-color);
  border-radius: 8px;
  box-shadow: 0 4px 14px rgba(0, 0, 0, 0.12);
}

.clivia-dropdown:hover .clivia-dropdown-menu {
  display: block;
}

.clivia-dropdown-menu a {
  display: block;
  padding: 3px 0;
  font-size: 14px;
  color: var(--text-color);
  white-space: nowrap;
}

.clivia-dropdown-menu a:hover {
  color: var(--link-hover-color);
}

@media (min-width: 992px) {
  body {
    padding-top: 48px; // 给 fixed 导航条让位
  }

  .clivia-navbar {
    display: block;
  }

  // 导航条已覆盖全部入口，原生菜单在桌面端隐藏（移动端仍走汉堡菜单）
  .site-nav {
    display: none;
  }

  // 左栏折叠后品牌区随之隐藏，导航条显示 CLIVIA 字标补位
  html.sidebar-collapsed .clivia-navbar-brand {
    display: inline-flex;
  }
}

